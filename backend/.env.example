# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/reader_agent

# FIPAI
FIPAI_BASE_URL=http://127.0.0.1:8000
FIPAI_INSTANCE_ID=bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb
FIPAI_BEARER_TOKEN=
FIPAI_API_KEY=
FIPAI_TIMEOUT_SEC=120

# Storage
STORAGE_URL=./storage

# OpenAI (for embeddings)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=text-embedding-3-small

# App
APP_NAME=Reader Agent Backend
DEBUG=false
AUTH_SECRET_KEY=change-this-in-production
AUTH_TOKEN_TTL_HOURS=24
RAG_MIN_CITATIONS=2
DEV_LOGIN_USERS={"demo@example.com":"demo"}
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
PUBLIC_STORAGE_ENABLED=true
AUTO_GENERATE_NOTE=true
